# Copiá este archivo a .env.local y completá los valores.
# No subas .env.local a git.

# ── Supabase (Project Settings → API) ──
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Solo servidor: panel /admin (clave service_role, secret)
SUPABASE_SERVICE_ROLE_KEY=

# Cookie de sesión admin (ej. openssl rand -hex 32)
ADMIN_SESSION_SECRET=

# ── Resend (https://resend.com/api-keys) ──
RESEND_API_KEY=re_xxxxxxxx
RESEND_FROM_EMAIL=Vir y Seba <noreply@viryseba.com.ar>

# URL pública del sitio (calendario .ics en mails)
NEXT_PUBLIC_SITE_URL=https://www.viryseba.com.ar
