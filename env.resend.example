# Copiá estas variables a .env.local (junto con Supabase)

# API key: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxx

# Remitente: el dominio viryseba.com.ar debe estar VERIFICADO en Resend → Domains
RESEND_FROM_EMAIL=noreply@viryseba.com.ar

# URL pública del sitio (para el .ics de iPhone en los mails)
NEXT_PUBLIC_SITE_URL=https://www.viryseba.com.ar
