# Renombrá a .env.local o copiá las variables al archivo .env.local
# Valores: Supabase → Project Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Obligatorio para /admin (login y dashboard). Copiá la clave "service_role" (secret).
# Sin esto verás error al intentar entrar al panel.
SUPABASE_SERVICE_ROLE_KEY=

# Cadena aleatoria larga para firmar la cookie de sesión admin (ej. openssl rand -hex 32)
ADMIN_SESSION_SECRET=

# Resend (emails al confirmar RSVP) — ver también env.resend.example
RESEND_API_KEY=
RESEND_FROM_EMAIL=Vir y Seba <noreply@viryseba.com.ar>
NEXT_PUBLIC_SITE_URL=https://www.viryseba.com.ar
